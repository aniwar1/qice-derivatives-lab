{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade_intent.v1.schema.json",
  "title": "Forward-registered option trade intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trade_id",
    "decision_id",
    "instrument",
    "strategy_context",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "trade_intent.v1"},
    "trade_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "decision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "instrument": {"$ref": "#/$defs/instrument"},
    "strategy_context": {"$ref": "#/$defs/strategy_context"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    }
  },
  "$defs": {
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "analysis_contract", "option_contract", "option_route"],
      "properties": {
        "product": {"type": "string", "pattern": "^[A-Z]{1,3}$"},
        "analysis_contract": {"type": "string", "pattern": "^[A-Z]{1,3}[0-9]{4}$"},
        "option_contract": {"type": "string", "pattern": "^[A-Za-z0-9-]{3,40}$"},
        "option_route": {"enum": ["long_call", "long_put"]}
      }
    },
    "strategy_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directional_view", "entry_style", "market_regime"],
      "properties": {
        "directional_view": {"enum": ["long", "short"]},
        "entry_style": {
          "enum": [
            "anticipatory_breakout",
            "confirmed_breakout",
            "trend_pullback",
            "structural_reversal",
            "pre_event_positioning",
            "post_event_continuation",
            "other_explained"
          ]
        },
        "market_regime": {"enum": ["trend", "range", "event", "transition", "unknown"]},
        "entry_style_detail": {"type": "string", "minLength": 1, "maxLength": 160}
      },
      "allOf": [
        {
          "if": {
            "properties": {"entry_style": {"const": "other_explained"}},
            "required": ["entry_style"]
          },
          "then": {"required": ["entry_style_detail"]},
          "else": {"not": {"required": ["entry_style_detail"]}}
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "captured_at", "supports"],
      "properties": {
        "kind": {
          "enum": [
            "decision_artifact",
            "broker_statement",
            "broker_execution_export",
            "exchange_confirmation",
            "account_statement",
            "other_verifiable_artifact"
          ]
        },
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "captured_at": {"type": "string", "format": "date-time"},
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["decision", "entry", "exit", "fees", "other_costs"]}
        }
      }
    }
  }
}
