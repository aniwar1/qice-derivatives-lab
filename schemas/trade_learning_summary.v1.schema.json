{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade_learning_summary.v1.schema.json",
  "title": "Deterministic trade-learning dashboard summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "classification_policy",
    "lesson_policy",
    "statistics",
    "patterns",
    "claim_boundary",
    "summary_sha256"
  ],
  "properties": {
    "schema_version": {"const": "trade_learning_summary.v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_count", "registered_intent_count", "closed_trade_count", "head_event_hash", "as_of"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 0},
        "registered_intent_count": {"type": "integer", "minimum": 0},
        "closed_trade_count": {"type": "integer", "minimum": 0},
        "head_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "as_of": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "classification_policy": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "required": ["basis", "win", "loss", "breakeven", "gross_formula", "net_formula", "slippage_accounting"]
    },
    "lesson_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_supporting_trades",
        "minimum_distinct_products",
        "candidate_is_association_not_causation",
        "agent_review_required",
        "explicit_user_confirmation_required",
        "separate_authorized_rule_change_required",
        "automatic_rule_updates"
      ],
      "properties": {
        "minimum_supporting_trades": {"type": "integer", "minimum": 1},
        "minimum_distinct_products": {"type": "integer", "minimum": 1},
        "candidate_is_association_not_causation": {"const": true},
        "agent_review_required": {"const": true},
        "explicit_user_confirmation_required": {"const": true},
        "separate_authorized_rule_change_required": {"const": true},
        "automatic_rule_updates": {"const": false}
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wins",
        "losses",
        "breakevens",
        "win_share",
        "loss_share",
        "breakeven_share",
        "gross_pnl_cny",
        "net_pnl_cny",
        "average_net_pnl_cny",
        "commission_cny",
        "observed_slippage_cny",
        "other_costs_cny"
      ],
      "properties": {
        "wins": {"type": "integer", "minimum": 0},
        "losses": {"type": "integer", "minimum": 0},
        "breakevens": {"type": "integer", "minimum": 0},
        "win_share": {"$ref": "#/$defs/nullable_share"},
        "loss_share": {"$ref": "#/$defs/nullable_share"},
        "breakeven_share": {"$ref": "#/$defs/nullable_share"},
        "gross_pnl_cny": {"$ref": "#/$defs/decimal"},
        "net_pnl_cny": {"$ref": "#/$defs/decimal"},
        "average_net_pnl_cny": {"$ref": "#/$defs/decimal"},
        "commission_cny": {"$ref": "#/$defs/decimal"},
        "observed_slippage_cny": {"$ref": "#/$defs/decimal"},
        "other_costs_cny": {"$ref": "#/$defs/decimal"}
      }
    },
    "patterns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["winning_strengths", "losing_causes", "breakeven_observations"],
      "properties": {
        "winning_strengths": {"type": "array", "items": {"$ref": "#/$defs/pattern"}},
        "losing_causes": {"type": "array", "items": {"$ref": "#/$defs/pattern"}},
        "breakeven_observations": {"type": "array", "items": {"$ref": "#/$defs/pattern"}}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptive_not_profitability_proof",
        "tags_are_review_attributions_not_verified_causality",
        "no_direction_or_trade_is_recommended",
        "no_chain_of_thought_is_stored",
        "artifact_hashes_preserve_bytes_not_source_authenticity",
        "full_privileged_ledger_replacement_is_not_detectable_without_external_anchor"
      ],
      "properties": {
        "descriptive_not_profitability_proof": {"const": true},
        "tags_are_review_attributions_not_verified_causality": {"const": true},
        "no_direction_or_trade_is_recommended": {"const": true},
        "no_chain_of_thought_is_stored": {"const": true},
        "artifact_hashes_preserve_bytes_not_source_authenticity": {"const": true},
        "full_privileged_ledger_replacement_is_not_detectable_without_external_anchor": {"const": true}
      }
    },
    "summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "nullable_share": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^(?:0|1)\\.[0-9]{4}$"}
      ]
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "pattern_kind",
        "tag",
        "label_zh",
        "support_count",
        "cohort_size",
        "cohort_share",
        "distinct_products",
        "entry_styles",
        "option_routes",
        "supporting_trade_ids",
        "status",
        "rule_change_authorized"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^lesson-[0-9a-f]{16}$"},
        "pattern_kind": {"enum": ["winning_strength", "losing_cause", "breakeven_observation"]},
        "tag": {"type": "string", "minLength": 1},
        "label_zh": {"type": "string", "minLength": 1},
        "support_count": {"type": "integer", "minimum": 1},
        "cohort_size": {"type": "integer", "minimum": 1},
        "cohort_share": {"type": "string", "pattern": "^(?:0|1)\\.[0-9]{4}$"},
        "distinct_products": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{1,3}$"}},
        "entry_styles": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "option_routes": {"type": "array", "uniqueItems": true, "items": {"enum": ["long_call", "long_put"]}},
        "supporting_trade_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "status": {"enum": ["observation", "candidate_lesson"]},
        "rule_change_authorized": {"const": false}
      }
    }
  }
}
