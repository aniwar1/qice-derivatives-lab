{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/schemas/skill_dashboard_snapshot.v1.schema.json",
  "title": "Unified Skill and decision dashboard snapshot v1",
  "description": "Read-only projection of one decision run, the complete Skill architecture, current universe, typed evidence, optional long-option expression and verified trade-learning summary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "skill",
    "current_run",
    "architecture",
    "universe",
    "evidence",
    "underlying_thesis",
    "option_expression",
    "lifecycle",
    "learning",
    "boundaries"
  ],
  "properties": {
    "schema_version": {"const": "skill_dashboard_snapshot.v1"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "skill": {"$ref": "#/$defs/skill"},
    "current_run": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/currentRun"}
      ]
    },
    "architecture": {"$ref": "#/$defs/architecture"},
    "universe": {"$ref": "#/$defs/universe"},
    "evidence": {
      "type": "array",
      "items": {"$ref": "evidence_packet.v1.schema.json"}
    },
    "underlying_thesis": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/underlyingThesis"}
      ]
    },
    "option_expression": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "option_decision.v1.schema.json"}
      ]
    },
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "learning": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "trade_learning_summary.v1.schema.json"}
      ]
    },
    "boundaries": {"$ref": "#/$defs/boundaries"}
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 20
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "product": {
      "type": "string",
      "pattern": "^[A-Z]{1,3}$"
    },
    "contract": {
      "type": "string",
      "pattern": "^[A-Z]{1,3}[0-9]{4}$"
    },
    "taskMode": {
      "enum": [
        "education",
        "universe_maintenance",
        "all_market_scan",
        "option_efficiency_scan",
        "single_analysis",
        "option_entry",
        "position_review",
        "trade_review"
      ]
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "display_name",
        "architecture",
        "skill_sha256",
        "orchestration_policy_sha256"
      ],
      "properties": {
        "name": {"const": "cn-futures-decision-agent"},
        "display_name": {"type": "string", "minLength": 1},
        "architecture": {"const": "evidence_gated_adaptive_decision_graph.v1"},
        "skill_sha256": {"$ref": "#/$defs/sha256"},
        "orchestration_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_count",
        "universe_sha256",
        "product_specs_sha256",
        "report_policy_sha256",
        "orchestration_policy_sha256"
      ],
      "properties": {
        "product_count": {"type": "integer", "minimum": 1},
        "universe_sha256": {"$ref": "#/$defs/sha256"},
        "product_specs_sha256": {"$ref": "#/$defs/sha256"},
        "report_policy_sha256": {"$ref": "#/$defs/sha256"},
        "orchestration_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "qualityReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critic_revisions", "unresolved_material_issue"],
      "properties": {
        "critic_revisions": {"type": "integer", "minimum": 0, "maximum": 1},
        "unresolved_material_issue": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 4000}
          ]
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_placement_authorized", "short_option_open_allowed"],
      "properties": {
        "order_placement_authorized": {"const": false},
        "short_option_open_allowed": {"const": false}
      }
    },
    "currentRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "task_mode",
        "phase",
        "product",
        "requested_contract",
        "updated_at",
        "missing_required_evidence_domains",
        "ready_for_agent",
        "scope",
        "quality_review",
        "permissions"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "task_mode": {"$ref": "#/$defs/taskMode"},
        "phase": {
          "enum": [
            "planned",
            "collecting_evidence",
            "ready_for_agent",
            "agent_decided",
            "quality_review",
            "finalized",
            "blocked"
          ]
        },
        "product": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/product"}
          ]
        },
        "requested_contract": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/contract"}
          ]
        },
        "updated_at": {"$ref": "#/$defs/timestamp"},
        "missing_required_evidence_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceDomain"}
        },
        "ready_for_agent": {"type": "boolean"},
        "scope": {"$ref": "#/$defs/scope"},
        "quality_review": {"$ref": "#/$defs/qualityReview"},
        "permissions": {"$ref": "#/$defs/permissions"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "owner", "status", "summary"],
      "properties": {
        "id": {
          "enum": [
            "intent_router",
            "scope_gate",
            "market_scan",
            "contract_binding",
            "evidence_fanout",
            "evidence_validation",
            "agent_hypothesis",
            "entry_path_comparison",
            "option_expression",
            "bounded_critic",
            "final_validation",
            "position_lifecycle",
            "unified_dashboard",
            "learning_review"
          ]
        },
        "label": {"type": "string", "minLength": 1},
        "owner": {
          "enum": ["deterministic", "specialists", "agent", "state_machine", "renderer"]
        },
        "status": {
          "enum": [
            "idle",
            "planned",
            "waiting",
            "ready",
            "in_progress",
            "active",
            "complete",
            "blocked",
            "optional",
            "skipped"
          ]
        },
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges",
        "decision_owner",
        "specialists_vote",
        "maximum_critic_revisions"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {"$ref": "#/$defs/node"},
          "allOf": [
            {"contains": {"properties": {"id": {"const": "intent_router"}}, "required": ["id"]}},
            {"contains": {"properties": {"id": {"const": "scope_gate"}}, "required": ["id"]}},
            {"contains": {"properties": {"id": {"const": "market_scan"}}, "required": ["id"]}},
            {"contains": {"properties": {"id": {"const": "contract_binding"}}, "required": ["id"]}},
            {"contains": {"properties": {"id": {"const": "evidence_fanout"}}, "required": ["id"]}},
            {"contains": {"properties": {"id": {"const": "evidence_validation"}}, "required": ["id"]}},
            {"contains": {"properties": {"id": {"const": "agent_hypothesis"}}, "required": ["id"]}},
            {"contains": {"properties": {"id": {"const": "entry_path_comparison"}}, "required": ["id"]}},
            {"contains": {"properties": {"id": {"const": "option_expression"}}, "required": ["id"]}},
            {"contains": {"properties": {"id": {"const": "bounded_critic"}}, "required": ["id"]}},
            {"contains": {"properties": {"id": {"const": "final_validation"}}, "required": ["id"]}},
            {"contains": {"properties": {"id": {"const": "position_lifecycle"}}, "required": ["id"]}},
            {"contains": {"properties": {"id": {"const": "unified_dashboard"}}, "required": ["id"]}},
            {"contains": {"properties": {"id": {"const": "learning_review"}}, "required": ["id"]}}
          ]
        },
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "string", "minLength": 1},
              {"type": "string", "minLength": 1}
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "decision_owner": {"const": "agent"},
        "specialists_vote": {"const": false},
        "maximum_critic_revisions": {"const": 1}
      }
    },
    "productGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "products"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "products": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/product"}
        }
      }
    },
    "exposureCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "products", "selection_policy"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "products": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/product"}
        },
        "selection_policy": {"type": "string", "minLength": 1}
      }
    },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_count",
        "effective_since",
        "products",
        "primary_groups",
        "correlated_exposure_clusters"
      ],
      "properties": {
        "product_count": {"type": "integer", "minimum": 1},
        "effective_since": {"type": "string", "format": "date"},
        "products": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/product"}
        },
        "primary_groups": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/productGroup"}
        },
        "correlated_exposure_clusters": {
          "type": "array",
          "items": {"$ref": "#/$defs/exposureCluster"}
        }
      }
    },
    "evidenceDomain": {
      "enum": [
        "market_contract",
        "technical_structure",
        "fundamentals_news",
        "member_flow",
        "option_chain",
        "account_position",
        "realized_trade"
      ]
    },
    "underlyingThesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "product",
        "analysis_contract",
        "directional_view",
        "path",
        "trigger",
        "target",
        "futures_structure_invalidation",
        "latest_realization_time",
        "why_now",
        "why_not_opposite",
        "why_not_wait",
        "strongest_counterevidence",
        "falsifiers",
        "selected_by_agent"
      ],
      "properties": {
        "schema_version": {"const": "underlying_thesis.v1"},
        "product": {"$ref": "#/$defs/product"},
        "analysis_contract": {"$ref": "#/$defs/contract"},
        "directional_view": {"enum": ["long", "short", "neutral", "uncertain"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 4000},
        "trigger": {"type": "string", "minLength": 1, "maxLength": 4000},
        "target": {"type": "string", "minLength": 1, "maxLength": 4000},
        "futures_structure_invalidation": {"type": "string", "minLength": 1, "maxLength": 4000},
        "latest_realization_time": {"$ref": "#/$defs/timestamp"},
        "why_now": {"type": "string", "minLength": 1, "maxLength": 4000},
        "why_not_opposite": {"type": "string", "minLength": 1, "maxLength": 4000},
        "why_not_wait": {"type": "string", "minLength": 1, "maxLength": 4000},
        "strongest_counterevidence": {"type": "string", "minLength": 1, "maxLength": 4000},
        "falsifiers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 4000}
        },
        "selected_by_agent": {"const": true},
        "daily_bar_basis": {"$ref": "#/$defs/dailyBarBasis"}
      }
    },
    "dailyBarBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_packet_id", "bar_state", "as_of", "decision_semantics"],
      "properties": {
        "evidence_packet_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "bar_state": {"enum": ["session_partial", "completed"]},
        "as_of": {"$ref": "#/$defs/timestamp"},
        "decision_semantics": {"enum": ["anticipatory", "conditional", "confirmed_daily_breakout"]}
      }
    },
    "lifecycleState": {
      "enum": [
        "screened",
        "shortlisted",
        "evidence_ready",
        "degraded",
        "armed",
        "wait",
        "entered",
        "target_hit",
        "option_execution_stop",
        "time_expired",
        "thesis_changed",
        "closed",
        "reviewed"
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_state", "allowed_states", "monitor_required_for_immediate_stop"],
      "properties": {
        "current_state": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/lifecycleState"}
          ]
        },
        "allowed_states": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/lifecycleState"}
        },
        "monitor_required_for_immediate_stop": {"const": true}
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine_selected_action",
        "validation_is_trade_permission",
        "order_placement_authorized",
        "short_option_open_allowed",
        "learning_auto_modifies_skill",
        "hidden_reasoning_persisted"
      ],
      "properties": {
        "machine_selected_action": {"const": false},
        "validation_is_trade_permission": {"const": false},
        "order_placement_authorized": {"const": false},
        "short_option_open_allowed": {"const": false},
        "learning_auto_modifies_skill": {"const": false},
        "hidden_reasoning_persisted": {"const": false}
      }
    }
  }
}
