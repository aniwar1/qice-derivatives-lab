{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "latest_strategy.v1.schema.json",
  "title": "Latest validated research strategy v1",
  "description": "Fail-closed projection of one finalized Agent-owned decision. It is not an order or trading permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "strategy_status",
    "source_run",
    "task_mode",
    "product",
    "analysis_contract",
    "technical_basis",
    "underlying_thesis",
    "option_expression",
    "lifecycle_state",
    "valid_until",
    "boundaries",
    "strategy_sha256"
  ],
  "properties": {
    "schema_version": {"const": "latest_strategy.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "strategy_status": {"const": "current_research_decision"},
    "source_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "phase", "updated_at", "decision_run_sha256", "scope"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "phase": {"const": "finalized"},
        "updated_at": {"type": "string", "format": "date-time"},
        "decision_run_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scope": {"type": "object"}
      }
    },
    "task_mode": {"enum": ["all_market_scan", "single_analysis", "option_entry", "position_review"]},
    "product": {"type": "string", "pattern": "^[A-Z]{1,3}$"},
    "analysis_contract": {"type": "string", "pattern": "^[A-Z]{1,3}[0-9]{4}$"},
    "technical_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_packet_id",
        "bar_state",
        "trade_date",
        "as_of",
        "decision_semantics",
        "coverage",
        "source",
        "confirmed_daily_breakout_claim_eligible"
      ],
      "properties": {
        "evidence_packet_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "bar_state": {"enum": ["session_partial", "completed"]},
        "trade_date": {"type": "string", "format": "date"},
        "as_of": {"type": "string", "format": "date-time"},
        "decision_semantics": {"enum": ["anticipatory", "conditional", "confirmed_daily_breakout"]},
        "coverage": {"type": "object"},
        "source": {"type": "object"},
        "confirmed_daily_breakout_claim_eligible": {"type": "boolean"}
      }
    },
    "underlying_thesis": {"type": "object"},
    "option_expression": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "option_decision.v1.schema.json"}
      ]
    },
    "lifecycle_state": {"type": ["string", "null"]},
    "valid_until": {"type": "string", "format": "date-time"},
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine_selected_action",
        "validation_is_trade_permission",
        "order_placement_authorized",
        "automatic_ordering",
        "short_option_open_allowed"
      ],
      "properties": {
        "machine_selected_action": {"const": false},
        "validation_is_trade_permission": {"const": false},
        "order_placement_authorized": {"const": false},
        "automatic_ordering": {"const": false},
        "short_option_open_allowed": {"const": false}
      }
    },
    "strategy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
