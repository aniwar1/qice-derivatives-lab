{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/schemas/option_decision.v1.schema.json",
  "title": "Chinese commodity long-option decision",
  "description": "A separately validated option-expression contract bound to a futures_main_report.v3 underlying thesis. Validation checks facts, arithmetic, provenance and internal consistency only; it never selects direction or authorizes an order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "decision_mode",
    "underlying_thesis",
    "option_market",
    "option_expression",
    "position",
    "economics",
    "scenario_grid",
    "rationale",
    "reassessment",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "option_decision.v1"},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "decision_mode": {"enum": ["new_entry", "position_review"]},
    "underlying_thesis": {"$ref": "#/$defs/underlyingThesis"},
    "option_market": {"$ref": "#/$defs/optionMarket"},
    "option_expression": {"$ref": "#/$defs/optionExpression"},
    "position": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/position"}
      ]
    },
    "economics": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/economics"}
      ]
    },
    "scenario_grid": {
      "type": "array",
      "items": {"$ref": "#/$defs/scenario"},
      "maxItems": 12
    },
    "rationale": {"$ref": "#/$defs/rationale"},
    "reassessment": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/reassessment"}
      ]
    },
    "claim_boundary": {"$ref": "#/$defs/claimBoundary"}
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 20
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract": {
      "type": "string",
      "pattern": "^[A-Z]{1,3}[0-9]{4}$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "nonNegativeNumberOrNull": {
      "oneOf": [
        {"type": "null"},
        {"type": "number", "minimum": 0}
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "retrieved_at", "content_sha256", "locator"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 2048
        },
        "retrieved_at": {"$ref": "#/$defs/timestamp"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "locator": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "sourceReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "futures_main_report.v3"}
      }
    },
    "underlyingSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "observed_at", "price", "source"],
      "properties": {
        "contract": {"$ref": "#/$defs/contract"},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "price": {"type": "number", "exclusiveMinimum": 0},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "underlyingLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "price", "source_ref"],
      "properties": {
        "condition": {
          "enum": [
            "underlying_at_or_above",
            "underlying_at_or_below",
            "completed_close_at_or_above",
            "completed_close_at_or_below"
          ]
        },
        "price": {"type": "number", "exclusiveMinimum": 0},
        "source_ref": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "futuresInvalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "price", "timeframe", "source_ref"],
      "properties": {
        "condition": {
          "enum": [
            "completed_close_at_or_above",
            "completed_close_at_or_below"
          ]
        },
        "price": {"type": "number", "exclusiveMinimum": 0},
        "timeframe": {"$ref": "#/$defs/nonEmptyText"},
        "source_ref": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "underlyingThesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_report",
        "product",
        "actual_main_contract",
        "analysis_contract",
        "directional_view",
        "underlying_action",
        "underlying_snapshot",
        "trigger",
        "target",
        "futures_structure_invalidation",
        "time_failure_reference_price",
        "latest_realization_time",
        "summary"
      ],
      "properties": {
        "source_report": {"$ref": "#/$defs/sourceReport"},
        "product": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}$"
        },
        "actual_main_contract": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/contract"}
          ]
        },
        "analysis_contract": {"$ref": "#/$defs/contract"},
        "directional_view": {
          "enum": ["long", "short", "neutral", "uncertain"]
        },
        "underlying_action": {"enum": ["long", "short", "wait"]},
        "underlying_snapshot": {"$ref": "#/$defs/underlyingSnapshot"},
        "trigger": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/underlyingLevel"}
          ]
        },
        "target": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/underlyingLevel"}
          ]
        },
        "futures_structure_invalidation": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/futuresInvalidation"}
          ]
        },
        "time_failure_reference_price": {
          "oneOf": [
            {"type": "null"},
            {"type": "number", "exclusiveMinimum": 0}
          ]
        },
        "latest_realization_time": {"$ref": "#/$defs/timestamp"},
        "summary": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "optionQuote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "bid",
        "ask",
        "last",
        "volume",
        "open_interest",
        "tick_size",
        "source"
      ],
      "properties": {
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "bid": {"$ref": "#/$defs/nonNegativeNumberOrNull"},
        "ask": {"$ref": "#/$defs/nonNegativeNumberOrNull"},
        "last": {"$ref": "#/$defs/nonNegativeNumberOrNull"},
        "volume": {"type": "integer", "minimum": 0},
        "open_interest": {"type": "integer", "minimum": 0},
        "tick_size": {"type": "number", "exclusiveMinimum": 0},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "optionAnalytics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "implied_volatility",
        "delta",
        "gamma",
        "theta",
        "vega",
        "method",
        "source"
      ],
      "properties": {
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "implied_volatility": {"type": "number", "exclusiveMinimum": 0},
        "delta": {"type": "number", "minimum": -1, "maximum": 1},
        "gamma": {"type": "number", "minimum": 0},
        "theta": {"type": "number"},
        "vega": {"type": "number", "minimum": 0},
        "method": {"$ref": "#/$defs/nonEmptyText"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "optionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "option_type",
        "underlying_contract",
        "expiration_date",
        "expiration_at",
        "strike",
        "contract_multiplier",
        "contract_source",
        "quote",
        "analytics"
      ],
      "properties": {
        "symbol": {"$ref": "#/$defs/nonEmptyText"},
        "option_type": {"enum": ["call", "put"]},
        "underlying_contract": {"$ref": "#/$defs/contract"},
        "expiration_date": {"$ref": "#/$defs/date"},
        "expiration_at": {"$ref": "#/$defs/timestamp"},
        "strike": {"type": "number", "exclusiveMinimum": 0},
        "contract_multiplier": {"type": "number", "exclusiveMinimum": 0},
        "contract_source": {"$ref": "#/$defs/source"},
        "quote": {"$ref": "#/$defs/optionQuote"},
        "analytics": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/optionAnalytics"}
          ]
        }
      }
    },
    "liquidity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "spread", "spread_ticks", "reason"],
      "properties": {
        "status": {"enum": ["executable", "incomplete", "unobservable"]},
        "spread": {"$ref": "#/$defs/nonNegativeNumberOrNull"},
        "spread_ticks": {"$ref": "#/$defs/nonNegativeNumberOrNull"},
        "reason": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "optionMarket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "freshness_limit_seconds",
        "quote_age_seconds",
        "selected_contract",
        "liquidity"
      ],
      "properties": {
        "status": {"enum": ["fresh", "stale", "unobservable"]},
        "freshness_limit_seconds": {"type": "integer", "minimum": 1},
        "quote_age_seconds": {"$ref": "#/$defs/nonNegativeNumberOrNull"},
        "selected_contract": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/optionContract"}
          ]
        },
        "liquidity": {"$ref": "#/$defs/liquidity"}
      }
    },
    "conditionalPrecondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "requires_fresh_quote",
        "requires_same_underlying_contract",
        "requires_executable_bid_ask"
      ],
      "properties": {
        "condition": {"$ref": "#/$defs/nonEmptyText"},
        "requires_fresh_quote": {"const": true},
        "requires_same_underlying_contract": {"const": true},
        "requires_executable_bid_ask": {"const": true}
      }
    },
    "optionExecutionStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "price", "source_ref"],
      "properties": {
        "condition": {
          "enum": ["underlying_at_or_above", "underlying_at_or_below"]
        },
        "price": {"type": "number", "exclusiveMinimum": 0},
        "source_ref": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "optionExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capital_action",
        "option_route",
        "entry_timing",
        "entry_style",
        "conditional_precondition",
        "option_execution_stop",
        "one_entry_only",
        "one_full_exit_only",
        "pyramiding",
        "averaging_down"
      ],
      "properties": {
        "capital_action": {"enum": ["buy_to_open", "wait", "hold", "close"]},
        "option_route": {"enum": ["long_call", "long_put", "wait"]},
        "entry_timing": {"enum": ["now", "conditional", "wait", "not_applicable"]},
        "entry_style": {
          "enum": [
            "anticipatory_breakout",
            "confirmed_breakout",
            "trend_pullback",
            "structural_reversal",
            "pre_event_positioning",
            "post_event_continuation",
            "other_explained",
            "wait",
            "position_review"
          ]
        },
        "conditional_precondition": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/conditionalPrecondition"}
          ]
        },
        "option_execution_stop": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/optionExecutionStop"}
          ]
        },
        "one_entry_only": {"const": true},
        "one_full_exit_only": {"const": true},
        "pyramiding": {"const": false},
        "averaging_down": {"const": false}
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "contract",
        "option_type",
        "underlying_contract",
        "quantity",
        "average_entry_premium",
        "opened_at",
        "entry_fees_total",
        "source"
      ],
      "properties": {
        "side": {"const": "long"},
        "contract": {"$ref": "#/$defs/nonEmptyText"},
        "option_type": {"enum": ["call", "put"]},
        "underlying_contract": {"$ref": "#/$defs/contract"},
        "quantity": {"type": "integer", "minimum": 1},
        "average_entry_premium": {"type": "number", "minimum": 0},
        "opened_at": {"$ref": "#/$defs/timestamp"},
        "entry_fees_total": {"type": "number", "minimum": 0},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "quantity",
        "premium_basis",
        "premium_per_unit",
        "contract_multiplier",
        "premium_notional",
        "entry_fees_total",
        "exit_fees_total",
        "entry_slippage_total",
        "exit_slippage_total",
        "total_cost_basis"
      ],
      "properties": {
        "currency": {"const": "CNY"},
        "quantity": {"type": "integer", "minimum": 1},
        "premium_basis": {"enum": ["current_ask", "position_average"]},
        "premium_per_unit": {"type": "number", "minimum": 0},
        "contract_multiplier": {"type": "number", "exclusiveMinimum": 0},
        "premium_notional": {"type": "number", "minimum": 0},
        "entry_fees_total": {"type": "number", "minimum": 0},
        "exit_fees_total": {"type": "number", "minimum": 0},
        "entry_slippage_total": {"type": "number", "minimum": 0},
        "exit_slippage_total": {"type": "number", "minimum": 0},
        "total_cost_basis": {"type": "number", "minimum": 0}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "underlying_case",
        "iv_case",
        "evaluation_time",
        "underlying_price",
        "implied_volatility",
        "estimated_option_value_per_unit",
        "estimated_net_pnl",
        "pricing_method",
        "model_or_source_ref"
      ],
      "properties": {
        "underlying_case": {
          "enum": [
            "target",
            "option_execution_stop",
            "futures_structure_invalidation",
            "time_failure"
          ]
        },
        "iv_case": {"enum": ["down", "flat", "up"]},
        "evaluation_time": {"$ref": "#/$defs/timestamp"},
        "underlying_price": {"type": "number", "exclusiveMinimum": 0},
        "implied_volatility": {"type": "number", "exclusiveMinimum": 0},
        "estimated_option_value_per_unit": {"type": "number", "minimum": 0},
        "estimated_net_pnl": {"type": "number"},
        "pricing_method": {"$ref": "#/$defs/nonEmptyText"},
        "model_or_source_ref": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_method",
        "action_reason",
        "why_not_alternative",
        "strongest_counterevidence",
        "why_enter_before_confirmation"
      ],
      "properties": {
        "decision_method": {"const": "agent_discretionary_synthesis"},
        "action_reason": {"$ref": "#/$defs/nonEmptyText"},
        "why_not_alternative": {"$ref": "#/$defs/nonEmptyText"},
        "strongest_counterevidence": {"$ref": "#/$defs/nonEmptyText"},
        "why_enter_before_confirmation": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/nonEmptyText"}
          ]
        }
      }
    },
    "reassessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reassess_by", "update_triggers"],
      "properties": {
        "reassess_by": {"$ref": "#/$defs/timestamp"},
        "update_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonEmptyText"}
        }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator_selected_direction",
        "validation_is_trade_permission",
        "automatic_ordering",
        "order_authorized"
      ],
      "properties": {
        "validator_selected_direction": {"const": false},
        "validation_is_trade_permission": {"const": false},
        "automatic_ordering": {"const": false},
        "order_authorized": {"const": false}
      }
    }
  }
}
