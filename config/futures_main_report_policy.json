{
  "schema_version": "futures_main_report_policy.v3",
  "policy_id": "futures_agent_discretionary_decision",
  "effective_since": "2026-09-13",
  "purpose": "在可追溯的技术结构、基本面与新闻、会员资金三面证据上，由Agent形成不可机械投票替代的long、short或wait判断；目标是提高长期可验证的成本后净收益，不承诺盈利，也不自动下单。",
  "scope": {
    "allowed_actions": ["long", "short", "wait"],
    "option_selection_owner": "user",
    "option_contract_iv_greeks_premium_and_route_are_out_of_scope": true,
    "futures_order_authorized_by_report": false,
    "automatic_ordering": false
  },
  "decision_contract": {
    "final_action_owner": "agent",
    "validator_role": "fact_arithmetic_provenance_and_internal_consistency_only",
    "evidence_completeness_is_trade_permission": false,
    "evidence_gap_mechanically_forces_wait": false,
    "majority_vote_allowed": false,
    "numeric_score_is_decision_authority": false,
    "objective": "improve_long_term_verifiable_net_profit_after_costs",
    "profit_guaranteed": false,
    "passing_validation_authorizes_order": false
  },
  "evidence_statuses": {
    "market_data": ["fresh", "stale", "unobservable"],
    "actual_main_chain": ["complete", "partial", "unobservable"],
    "technical_structure": ["available", "unobservable"],
    "fundamentals": ["available", "partial", "unobservable"],
    "important_news": ["material_events_found", "search_completed_no_material_news", "unobservable"],
    "member_flow": ["available", "partial", "unobservable"]
  },
  "scan_manifest": {
    "schema_version": "scan_manifest.v2",
    "all_market_expected_count": 22,
    "decision_use_max_age_seconds": 7200,
    "acquisition_max_batch_span_seconds": 900,
    "scan_age_must_be_disclosed": true,
    "scan_statuses": ["success", "partial", "unobservable"],
    "data_statuses": ["available", "partial", "unobservable"],
    "structure_statuses": ["available", "partial", "unobservable"],
    "canonical_hash": "sha256_utf8_sort_keys_compact_json_without_trailing_newline",
    "universe_policy_and_product_specs_hashes_required": true,
    "successful_partial_and_unobservable_must_be_disjoint_complete_partition": true,
    "counts_must_be_recomputed_from_products": true,
    "successful_as_of_dates_must_be_one_common_latest_completed_date": true,
    "raw_and_structure_artifacts_are_content_addressed_before_atomic_manifest_switch": true,
    "manifest_is_evidence_not_trade_authority": true
  },
  "source_evidence": {
    "required_fields": ["url", "retrieved_at", "content_sha256", "locator"],
    "sha256_format": "lowercase_hex_64",
    "retrieval_must_not_be_after_report_observation": true,
    "member_ranking_must_use_official_exchange_domain": true
  },
  "market_data_freshness": {
    "beijing_utc_offset_hours": 8,
    "live_report_max_age_seconds": 300,
    "future_clock_skew_seconds": 5,
    "active_quote_max_age_seconds": 60,
    "session_boundary_quote_max_gap_seconds": 60,
    "non_active_latest_session_max_age_seconds": 259200,
    "calendar_evidence_max_age_seconds": 86400,
    "latest_completed_bar_must_equal_derived_latest_session": true,
    "latest_completed_bar_requires_verified_final_raw_last_row": true,
    "official_exchange_daily_requires_official_domain": true,
    "closed_session_boundary_quote_is_fresh": true,
    "latest_completed_bar_evidence_kinds": ["official_exchange_daily", "actual_main_day_close_snapshot", "degraded_raw_completed_daily_row"],
    "completed_bar_daily_cache_artifact_requires_strict_replay": true,
    "degraded_completed_bar_provenance_status": "bound_to_raw_bytes_cache_artifact_not_replayed",
    "completed_bar_provenance_dimensions": ["completed_daily_bar_bound_to_raw_bytes", "daily_cache_artifact_replay_verified", "upstream_response_identity_verified"],
    "allowed_session_states": ["active", "break", "closed"],
    "regular_session_schedule_bjt": {
      "day_intervals": [["09:00", "10:15"], ["10:30", "11:30"], ["13:30", "15:00"]],
      "night_end_groups": {
        "NONE": ["AP", "CJ", "JD", "LC", "LH", "PK", "PS", "SI", "SM", "UR"],
        "23:00": ["CF", "FG", "JM", "M", "MA", "OI", "RU", "SA", "SP", "SR", "V"],
        "01:00": ["CU"],
        "02:30": []
      },
      "evidence_as_of": "2026-09-10T13:46:15+08:00",
      "evidence_kind": "contract_detail_plus_recent_one_minute_observation",
      "holiday_eve_and_temporary_change_rule": "交易所日历或临时公告优先于常规模板；非上期所品种的常规夜盘分组不得冒充全部官方确认。"
    },
    "session_aware_partial_daily_bar": {
      "schema_version": "session_aware_daily_bar_policy.v1",
      "decision_use_after_checkpoint": true,
      "checkpoint_basis": "post_regular_night_session_close",
      "night_session_start_bjt": "21:00:00",
      "checkpoint_by_night_end_group_bjt": {
        "23:00": "23:00:00",
        "01:00": "01:00:00",
        "02:30": "02:30:00"
      },
      "minimum_covered_trading_seconds": {
        "23:00": 7200,
        "01:00": 14400,
        "02:30": 19800
      },
      "no_night_product_partial_policy": "forbidden_until_completed_daily_close",
      "allowed_bar_states": ["session_partial", "completed"],
      "partial_allowed_decision_semantics": ["anticipatory", "conditional"],
      "completed_allowed_decision_semantics": ["anticipatory", "conditional", "confirmed_daily_breakout"],
      "confirmed_daily_breakout_requires_completed_bar": true,
      "partial_must_disclose": ["bar_state", "as_of", "coverage", "source", "calendar_evidence"],
      "partial_calendar_evidence_required": true,
      "completed_calendar_evidence_must_be_null": true,
      "calendar_evidence_regular_session_confirmed_required": true,
      "calendar_evidence_official_exchange_domain_required": true,
      "partial_is_not_completed_or_confirmed": true,
      "completed_structure_history_remains_causal_base": true,
      "partial_bar_is_current_session_overlay_not_pivot_confirmation": true,
      "temporary_schedule_or_calendar_uncertainty_fails_closed": true,
      "official_schedule_sources": [
        "https://www.shfe.com.cn/upload/20211021/1634804081608.pdf",
        "https://www.ine.cn/services/calenderandholidays/tradinghours/",
        "https://www.dce.com.cn/dalianshangpin/resource/cms/2019/04/2019042612023697006.pdf",
        "https://www.czce.com.cn/cn/flfg/zcjywgz/pzxz/webinfo/2024/02/1708568084281851.htm",
        "https://www.gfex.com.cn/gfex/sytslqhhy/202307/9ad927b8ec4c458594e172fd1ada2a9b.shtml"
      ]
    }
  },
  "actual_main": {
    "contract_chain_snapshot_max_span_seconds": 60,
    "selection_basis": "highest_open_interest_then_volume_then_contract_code",
    "chain_statuses": ["complete", "partial", "unobservable"],
    "snapshot_freshness_statuses": ["current_session", "historical_or_unbound"],
    "liquidity_statuses": ["observable_trade", "no_trade", "execution_quote_incomplete", "unobservable"],
    "raw_snapshot_path_and_sha256_required_when_observable": true,
    "verified_actual_main_requires_current_session_snapshot": true,
    "minimum_available_contract_rows": 1,
    "available_contract_count_must_equal_contract_rows": true,
    "complete_requires_pagination_complete_and_exact_source_count": true,
    "partial_requires_explicit_incomplete_reason": true,
    "unobservable_requires_zero_available_rows": true,
    "raw_request_mode_exchange_and_fetch_window_must_be_replayed": true,
    "focus_refresh_request_must_start_after_scan_focus_fetch": true,
    "incomplete_chain_is_uncertainty_for_agent_not_automatic_permission_or_rejection": true
  },
  "structure_evidence": {
    "statuses": ["available", "unobservable"],
    "required_binding_fields": ["structure_id", "algorithm_version", "as_of", "input_sha256", "input_snapshot_path", "artifact_sha256", "artifact", "contract"],
    "artifact_schema_version": "cn_futures_market_structure.v1",
    "allowed_algorithm_versions": ["causal_pivots_zones_theil_sen_tick_aligned.v1"],
    "available_requires_one_support_one_resistance_one_trend_and_direction": true,
    "unobservable_requires_null_levels_and_no_point_plan": true,
    "tick_size_evidence_required_when_available": true,
    "raw_and_structure_tick_size_evidence_must_match_exactly": true,
    "exact_tick_evidence_kind": "actual_contract_http_detail",
    "proxy_tick_evidence_kind": "product_specs_snapshot_proxy",
    "exact_tick_http_response_archive_required": true,
    "exact_tick_archive_hash_length_url_status_and_table_cell_must_replay": true,
    "tick_evidence_retrieval_must_be_inside_fetch_window": true,
    "daily_data_evidence_statuses": ["verified", "degraded", "unobservable"],
    "verified_daily_requires": ["exact_configured_product_scope", "archive_manifest", "independent_anchor", "gzip_payload", "contract_slice_replay"],
    "degraded_daily_requires_agent_coverage_gap": "daily_data_evidence_not_verified",
    "degraded_daily_mechanically_forces_direction_or_wait": false,
    "prices_must_be_positive_and_tick_aligned": true,
    "display_text_must_equal_numeric_fields": true,
    "historical_confirmation_requires_bound_confirming_bar_and_complete_subsequent_bar_chain": true,
    "historical_confirmation_requires_verified_final_raw_contiguous_subsequence": true,
    "historical_confirmation_requires_frozen_structure_and_final_raw_snapshots": true,
    "historical_confirmation_requires_independent_frozen_daily_artifact_replay": true,
    "frozen_structure_rows_must_overlap_final_raw_exactly": true,
    "non_historical_structure_and_final_raw_must_be_identical": true,
    "bare_previously_confirmed_on_forbidden": true
  },
  "decision_domains": [
    {"id": "technical_structure", "label": "技术结构", "role": "evidence_for_agent_synthesis_not_gate_or_vote"},
    {"id": "fundamentals_and_news", "label": "基本面与重要新闻", "role": "evidence_for_agent_synthesis_not_gate_or_vote"},
    {"id": "member_flow", "label": "近三日会员资金", "role": "evidence_for_agent_synthesis_not_gate_or_vote"}
  ],
  "fundamentals": {
    "directions": ["bullish", "bearish", "mixed", "neutral", "unobservable"],
    "contract_month_transmission_required": true,
    "counterevidence_required_per_item": true
  },
  "important_news": {
    "statuses": ["material_events_found", "search_completed_no_material_news", "unobservable"],
    "no_material_news_requires_completed_search_protocol": true,
    "no_material_news_forbids_event_placeholders": true,
    "search_protocol_required_fields": ["started_at", "completed_at", "query_terms", "materiality_criteria", "sources", "result_summary"]
  },
  "member_flow": {
    "completed_session_count": 3,
    "top_n": 20,
    "group_statuses": ["available", "partial", "unobservable"],
    "domestic_members": ["中信期货", "永安期货", "国泰君安", "银河期货", "东证期货"],
    "foreign_members": ["乾坤期货", "摩根大通", "瑞银期货"],
    "required_metrics": ["long_open_interest", "long_change", "short_open_interest", "short_change", "member_position_imbalance", "imbalance_change"],
    "required_normalized_metrics": ["previous_total_open_interest", "long_change_to_previous_oi", "short_change_to_previous_oi", "imbalance_change_to_previous_oi"],
    "top20_required_coverage_metrics": ["long_to_total_oi", "short_to_total_oi"],
    "flow_regimes": ["long_build_short_cover", "long_exit_short_build", "both_build", "deleveraging", "mixed_or_flat", "partial"],
    "price_open_interest_regimes": ["price_up_oi_up", "price_up_oi_down", "price_down_oi_up", "price_down_oi_down", "mixed_or_flat"],
    "required_session_context": ["contract", "close", "close_change", "volume", "total_open_interest", "total_open_interest_change", "price_open_interest_regime"],
    "prior_session_context_required_for_first_day_change": true,
    "named_member_prior_positions_required_for_first_day_change": true,
    "top20_change_basis": "exchange_published_change_because_membership_can_change",
    "top20_composition_basis": "exchange_published_top20_components",
    "numeric_fields_must_be_exact_integers_except_price": true,
    "positions_must_not_exceed_total_open_interest": true,
    "cross_contract_roll_rule": "do_not_sum_or_compare_across_contracts_without_an_explicit_roll_bridge",
    "missing_member_policy": "unobservable_not_zero",
    "official_source_required": true
  },
  "candidate_comparison": {
    "required_for_all_market": true,
    "method": "agent_comparison_without_score_or_rank_authority",
    "minimum_rejected_or_watch_candidates": 1,
    "partial_or_unobservable_candidates_are_allowed_with_explicit_gap_impact": true,
    "evidence_refs_and_cost_adjusted_opportunity_cost_reason_required": true
  },
  "point_plan": {
    "required_for_directional_action": true,
    "optional_for_any_agent_selected_wait": true,
    "one_entry_then_full_exit": true,
    "pyramiding": false,
    "average_down": false,
    "reference_reward_risk_is_arithmetic_not_permission": true,
    "minimum_reference_reward_risk": null,
    "target_requires_evidence_basis": true,
    "expected_net_value_is_agent_judgment": true,
    "confirmation_statuses": ["confirmed", "pending", "invalid"],
    "order_timings": ["now", "conditional"],
    "now_requires_factually_fresh_market_and_price_inside_entry_zone": true,
    "conditional_directional_action_requires_fresh_executable_quote_precondition": true,
    "pending_directional_action_requires_timing_override_rationale": true,
    "trigger_conditions": ["completed_close_at_or_above", "completed_close_at_or_below"],
    "invalidation_conditions": ["completed_close_at_or_below", "completed_close_at_or_above"]
  },
  "agent_judgment": {
    "decision_method": "agent_discretionary_synthesis",
    "domain_ids": ["technical_structure", "fundamentals_and_news", "member_flow"],
    "domain_stances": ["supports_long", "supports_short", "mixed", "neutral", "unobservable"],
    "confidence_range": [0, 1],
    "expected_net_values": ["positive", "negative", "uncertain"],
    "directional_views": ["long", "short", "neutral", "uncertain"],
    "capital_allocation_verdicts": ["deploy_conditionally", "preserve_capital"],
    "coverage_uncertainty_levels": ["low", "medium", "high"],
    "required_synthesis_fields": ["synthesis_thesis", "strongest_case_for", "strongest_case_against", "why_now", "why_not_wait", "why_not_opposite", "alternative", "invalidation", "expected_net_value", "coverage_uncertainty", "final_action"],
    "directional_action_requires_subjectively_positive_cost_adjusted_expected_net_value": true,
    "three_domains_must_not_be_counted_as_votes": true,
    "profit_guaranteed_must_be_false": true,
    "wait_requires_structured_reassessment": ["wait_for", "reassess_by", "update_triggers"],
    "directional_action_view_divergence_requires_structured_rationale": true
  },
  "execution_only_gates": [
    {"id": "broker_fees_and_margin", "label": "期货公司实时手续费与保证金"},
    {"id": "current_account_funds", "label": "当前柜台可用资金与清算权益"},
    {"id": "portfolio_stress", "label": "组合相关性与联合压力"},
    {"id": "manual_order_authorization", "label": "人工下单授权"}
  ],
  "execution_only_rule": "这些检查不替Agent形成方向判断；用户明确要求实际下单或手数前仍必须另行完成，报告本身不授权订单。",
  "report_order": ["agent_conclusion", "analysis_target_and_actual_main", "technical_structure", "fundamentals_and_news", "three_day_member_flow", "strongest_case_for_and_against", "point_plan_if_observable", "coverage_uncertainty_and_invalidation"]
